# Copiar a .env en la raíz y reemplazar ejemplos. Nunca versionar secretos.
DJANGO_SECRET_KEY=reemplazar-por-una-clave-local-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PUBLIC_URL=http://127.0.0.1:8000

# Conexión directa EXCLUSIVA para infraestructura Django en django_internal.
# Preparar esquema/roles según README antes de ejecutar migrate.
DB_NAME=postgres
DB_USER=planb_django_runtime
DB_PASSWORD=reemplazar-por-la-password-del-rol-tecnico
DB_HOST=localhost
DB_PORT=5432
# En despliegue remoto, usar TLS verificado según el proveedor.
DB_SSLMODE=prefer

# API de Supabase. Todas las claves se usan exclusivamente en el servidor.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=reemplazar-por-la-publishable-key
# Auth Admin y RPC exclusivas del backend para snapshots de recomendaciones.
SUPABASE_SECRET_KEY=reemplazar-por-la-secret-key

# Lugares recomendados: opcional, sólo backend. Sin clave se informa missing_api_key.
GEOAPIFY_API_KEY=

# Interpretación de actividad, sólo backend. Sin clave se informa missing_api_key.
GEMINI_API_KEY=
# Opcional: vacío usa gemini-3.8-flash. Sólo identificadores de modelos Gemini.
GEMINI_MODEL=
