# Copy to .env at the repository root and replace example values locally.
# Generate your own DJANGO_SECRET_KEY; this placeholder is not a real secret.
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Standard PostgreSQL connection (local or hosted).
DB_NAME=planb
DB_USER=planb_user
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=localhost
DB_PORT=5432

# Use the SSL mode required by your PostgreSQL provider (e.g. require).
DB_SSLMODE=prefer
